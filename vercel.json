{
  "version": 2,
  "builds": [
    { "src": "server.js", "use": "@vercel/node" },
    { "src": "public/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "server.js" },
    { "src": "/reset-password.html", "dest": "public/reset-password.html" },
    { "src": "/(.*\\.(html|css|js|png|ico|jpg|svg|webp|gif|woff|woff2|ttf))", "dest": "public/$1" },
    { "src": "/(.*)", "dest": "public/$1" }
  ]
}
